SITE_URL=https://uscale.in
# SITE_INDEXABLE=1
# OUTPUT_DIR=public
# BUILD_DATE=2026-10-06

# Blog + admin (Supabase → project uscale-blog → Connect → Transaction pooler)
DATABASE_URL=postgresql://uscale_app.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
SESSION_SECRET=change-me-to-32-plus-random-characters
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# INDEXNOW_KEY=
# CRON_SECRET=

# Free Google profile checker: PageSpeed Insights API key (free, no billing). Restrict it to the PageSpeed
# Insights API and to https://uscale.in/* referrers. Read at build time and placed in the page.
# PAGESPEED_KEY

# Shop reports and outreach (/r/<code>, admin → Outreach): Google Places API (New) key. Server-side only.
# Restrict it to the Places API (New). Billing must be on, but normal use stays inside the free monthly allowance.
# GOOGLE_PLACES_KEY=
# No Google Cloud? A free SerpApi key (serpapi.com, ~250 searches a month) works instead, used only when the Google key is empty.
# SERPAPI_KEY=

# WhatsApp score bot (/api/wa): Meta → your app → WhatsApp → API setup. Webhook URL: https://uscale.in/api/wa
# WA_TOKEN=
# WA_PHONE_ID=
# WA_VERIFY_TOKEN=
# WA_APP_SECRET=
# WA_DAILY_CHECKS=8
# Outreach page: shops per day (default 10). Public /check page: lookups per day, whole site (default 150).
# OUTREACH_DAILY=10
# CHECKS_PER_DAY=150
